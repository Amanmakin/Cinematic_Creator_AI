OPENAI_API_KEY=
REPLICATE_API_KEY=
UAR_ROOT=uar_assets
DB_PATH=projects.sqlite

# Plan8: Hybrid adapter / Docker diffusers
# Strategy: local_only | local_fallback | replicate_only | replicate_fallback
GENERATION_STRATEGY=local_fallback
# Port 8001 avoids conflict with FastAPI on 8000
DOCKER_DIFFUSERS_URL=http://localhost:8001
GENERATION_TIMEOUT_LOCAL=180
GENERATION_TIMEOUT_REPLICATE=120
# Set to false to use SDXL on M4 Pro or Linux GPU (slower, higher quality)
USE_SMALLER_MODELS_LOCALLY=true
# Docker container device: cpu | metal | cuda
DOCKER_DEVICE=cpu
DOCKER_SMALLER_MODEL=true
